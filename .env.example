# =====================================================
# clipbaa-scrapers — pipeline configuration
# Copy to `.env` (gitignored) and fill in what you need.
# Hitting targets live requires the `fetchers` extra:
#   pip install -e '.[fetchers]'   (Codespaces does this for you)
# =====================================================

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Output ---
OUTPUT_DIR=data
# HISTORY_DIR=data            # defaults to OUTPUT_DIR
# REPORT_TOP_N=25

# --- Scraping behaviour ---
# Set to true only on a dev box when you can't reach the site and accept
# synthetic data so the pipeline still proves the end-to-end flow.
# Never enabled silently: the CLI exits 4 instead of fabricating a result.
SCRAPLING_ALLOW_MOCK_FALLBACK=false
SCRAPLING_ADAPTIVE=false
SCRAPLING_ADAPTIVE_PERCENTAGE=40
# SCRAPLING_CRAWL_DIR=crawls   # incremental resume + adaptive fingerprints
# SCRAPLING_PROXY=socks5://user:pass@host:1080

# --- Amazon.in ---
AMAZON_MOVERS_URL=https://www.amazon.in/gp/movers-and-shakers
AMAZON_BESTSELLERS_URLS=https://www.amazon.in/bestsellers/kitchen,https://www.amazon.in/gp/bestsellers/kitchen/1380510031,https://www.amazon.in/gp/bestsellers/kitchen/1380374031,https://www.amazon.in/gp/bestsellers/kitchen/1380181031,https://www.amazon.in/gp/bestsellers/kitchen/1379989031
# AMAZON_NODE_CATEGORIES={"1380510031":"home-storage","1380374031":"home-decor","1380181031":"kitchen-tools","1379989031":"kitchen-storage"}

# --- Meesho ---
MEESHO_TRENDING_URL=https://www.meesho.com/trending

# --- Flipkart ---
FLIPKART_BESTSELLERS_URL=https://www.flipkart.com/best-sellers

# --- DeoDap ---
DEODAP_BASE_URL=https://deodap.in
DEODAP_CATEGORIES=kitchen-dining-items,cookware-items,home-storage-organisation-items,home-decor-wall-art-items,best-selling-products
DEODAP_MAX_PAGES=3

# --- Matching filters ---
MIN_CONFIDENCE=0.5
MIN_ABSOLUTE_MARGIN=200
MIN_MARGIN_PCT=35
MIN_TICKET_PRICE=300
MAX_SELLERS=5
MAX_FBA_SELLERS=2

# --- Reporting (optional) ---
# Sheets: service account JSON path + spreadsheet id (needs `sheets` extra)
# SHEETS_SERVICE_ACCOUNT=/path/to/service-account.json
# SHEETS_SPREADSHEET_ID=1abc...
# Webhook: HMAC-SHA256 signed POST
# WEBHOOK_URL=https://hooks.example.com/ingest
# WEBHOOK_SECRET=change-me
